{
  "manifest_version": 3,
  "name": "YADM",
  "version": "0.2.0",
  "description": "Send downloads to the YADM download manager.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "options_page": "options.html",
  "action": { "default_title": "YADM", "default_popup": "options.html" },
  "icons": { "128": "icon.png" },
  "browser_specific_settings": { "gecko": { "id": "yadm@yadm.dev" } }
}
